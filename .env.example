# Copy to .env (ignored by git) and fill in what you have. Never commit real values.
# Nothing here is needed for the demo: without these, every real client says "not configured" and the
# simulators (`--simulate`) and the dry runs do the work. Every API below is ASSUMED and none has been seen.

# Nightly reports (engine/scrapers/): python -m engine fetch --date D
UPRIGHT_URL=
UPRIGHT_TOKEN=
CASHMONKEY_URL=
CASHMONKEY_TOKEN=
EBAY_URL=
EBAY_TOKEN=
AMAZON_URL=
AMAZON_TOKEN=

# Month-end sources (engine/scrapers/): python -m engine fetch --close-month YYYY-MM
BC_URL=
BC_TOKEN=
BANK_FEED_URL=
BANK_FEED_TOKEN=
GOODWILLBOOKS_URL=
GOODWILLBOOKS_TOKEN=
JEWELRY_URL=
JEWELRY_TOKEN=
SHOPGOODWILL_URL=
SHOPGOODWILL_TOKEN=

# Goodwill's internal data for the scorecard (engine/internal_api/): INTERNAL_API=http uses the URL, else the mock
INTERNAL_API=
INTERNAL_API_URL=

# Loading the close into Business Central as drafts (docs/contracts/bc-api.md):
# python -m engine.export bc-api --month YYYY-MM --send
BC_TENANT_ID=
BC_ENVIRONMENT=
BC_COMPANY_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_DEPARTMENT_DIMENSION=

# Where the SQLite store lives (default out/store/ecom.db)
ECOM_DB=

# Also read, with defaults that work as they are (see the code for each):
#   PDF_BROWSER (engine/export/pdf.py), HOST, PORT, REPORTS_DIR, CLOSE_UPLOADS (server.py)
